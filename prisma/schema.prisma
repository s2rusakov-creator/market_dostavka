// YOL — доска заявок на передачу посылок Москва → Баку.
// Площадка не является стороной сделки: сводит отправителя и путешественника, дальше они сами.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  DOCUMENTS
  MEDICINE
  ELECTRONICS
  CLOTHES
  OTHER
}

/// Габариты задаются пресетом, а не сантиметрами: людям проще выбрать «в сумку».
enum SizePreset {
  POCKET
  BAG
  LUGGAGE
}

enum ListingStatus {
  ACTIVE
  MATCHED
  DONE
  CANCELLED
  EXPIRED
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id String @id @default(cuid())

  /// Telegram id не влезает в Int — только BigInt.
  /// Необязателен: войти можно и через почту, тогда Telegram не привязан.
  telegramId BigInt? @unique
  username   String?

  /// Почта — второй способ входа и ключ склейки аккаунтов: вход через Google
  /// и через пароль с одним адресом должны вести в один и тот же профиль.
  email           String?   @unique
  emailVerifiedAt DateTime?
  /// scrypt: соль и хеш в одной строке. Пусто у тех, кто входит только
  /// через Telegram или OAuth.
  passwordHash    String?

  firstName String
  lastName  String?
  photoUrl  String?
  /// Телефон нигде не публикуется, живёт только в личном чате.
  phone     String?

  locale          String  @default("ru")
  soundEnabled    Boolean @default(true)
  notifyEnabled   Boolean @default(true)
  /// Показывать ли в пуше имя и текст сообщения. Здесь договариваются о
  /// встречах и передают телефоны, а превью на экране блокировки видно
  /// любому, кто рядом. По умолчанию включено: так уведомление полезнее.
  notifyPreview   Boolean @default(true)
  /// Сколько раз человек довёз чужую посылку.
  deliveriesCount Int     @default(0)
  /// Сколько раз успешно отправил свою — это другая роль и другой счёт.
  sentCount       Int     @default(0)
  ratingSum       Int     @default(0)
  ratingCount     Int     @default(0)

  /// Защита от перебора пароля: счётчик неудач и время до разблокировки.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  acceptedTermsAt DateTime?
  createdAt       DateTime  @default(now())

  listings          Listing[]
  responses         Response[]
  threadsAsSender   Thread[]       @relation("ThreadSender")
  threadsAsTraveler Thread[]       @relation("ThreadTraveler")
  messages          Message[]
  reportsMade       Report[]       @relation("ReportAuthor")
  oauthAccounts     OAuthAccount[]
  reviewsWritten    Review[]       @relation("ReviewAuthor")
  reviewsReceived   Review[]       @relation("ReviewTarget")
  devices           DeviceToken[]
}

/// Устройство, на которое можно прислать пуш.
///
/// Отдельной таблицей, а не колонкой в User: у человека бывает телефон и
/// планшет, и уведомление должно прийти на оба. Токен выдаёт служба доставки
/// на устройстве и может сменить его в любой момент, поэтому уникален именно
/// он, а не пара «человек и платформа».
model DeviceToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Сам токен. Уникален глобально: одно устройство — одна запись, и если
  /// на телефоне сменился аккаунт, токен переезжает к новому владельцу.
  token String @unique

  /// Пока только "fcm". Поле заведено заранее: на телефонах без сервисов
  /// Google потребуется второй канал, и добавить его нужно будет без миграции.
  provider String @default("fcm")
  /// "android" | "ios" | "web"
  platform String

  createdAt DateTime @default(now())
  /// Обновляется при каждом заходе с этого устройства: по нему видно, какие
  /// токены давно мертвы, если служба доставки об этом не сказала сама.
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

model Listing {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  category    Category
  title       String
  description String?

  weightKg   Decimal?    @db.Decimal(5, 2)
  sizePreset SizePreset?
  dimensions String?

  /// deadlineFrom пустой — значит «до такого-то числа», без нижней границы.
  deadlineFrom DateTime?
  deadlineTo   DateTime
  pickupArea   String?

  priceRub Int
  photoUrl String?

  urgent       Boolean @default(false)
  fragile      Boolean @default(false)
  needsLuggage Boolean @default(false)

  status    ListingStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  responses Response[]
  threads   Thread[]
  reports   Report[]
  reviews   Review[]

  @@index([status, createdAt])
  @@index([status, category])
  @@index([authorId])
}

model Response {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  travelerId String
  traveler   User   @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  status    ResponseStatus @default(PENDING)
  createdAt DateTime       @default(now())

  /// Откликнуться на одну заявку можно только раз.
  @@unique([listingId, travelerId])
  @@index([travelerId])
}

model Thread {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("ThreadSender", fields: [senderId], references: [id], onDelete: Cascade)

  travelerId String
  traveler   User   @relation("ThreadTraveler", fields: [travelerId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages Message[]

  @@unique([listingId, travelerId])
  @@index([senderId, lastMessageAt])
  @@index([travelerId, lastMessageAt])
}

model Message {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  text      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([threadId, createdAt])
}

model Report {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  reason    String
  createdAt DateTime @default(now())

  @@unique([listingId, authorId])
}

/// Одноразовый код для входа через диплинк бота.
/// Виджет Telegram грузится с telegram.org, который в России недоступен, —
/// поэтому основной путь входа идёт через ссылку tg://, её обрабатывает
/// установленное приложение, минуя сайты Telegram.
model LoginCode {
  /// Сам код, он же первичный ключ: короткий, но с достаточной энтропией.
  code String @id

  /// Заполняются, когда бот получил /start с этим кодом.
  telegramId BigInt?
  userId     String?

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  /// Проставляется при обмене кода на сессию — повторно использовать нельзя.
  consumedAt DateTime?

  @@index([expiresAt])
}

/// Привязка внешнего аккаунта (Google, Mail.ru) к пользователю.
/// Отдельной таблицей, а не колонками в User: провайдеров может стать больше,
/// и один человек вправе привязать сразу несколько.
model OAuthAccount {
  id String @id @default(cuid())

  /// "google" | "mailru"
  provider          String
  /// Идентификатор пользователя у провайдера. Именно он, а не почта:
  /// почту в некоторых аккаунтах можно сменить.
  providerAccountId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Отзыв по завершённой сделке.
/// Оценивают друг друга обе стороны: отправитель — того, кто вёз, а
/// путешественник — того, чью посылку вёз. Для сервиса, где незнакомые люди
/// передают вещи, это единственное, что заменяет договор.
model Review {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  targetId String
  target   User   @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  /// От 1 до 5.
  rating    Int
  text      String?
  createdAt DateTime @default(now())

  /// По одной сделке человек оставляет один отзыв.
  @@unique([listingId, authorId])
  @@index([targetId])
}
