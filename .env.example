# --- База данных -----------------------------------------------------------
# Локальный PostgreSQL:
DATABASE_URL="postgresql://postgres:ПАРОЛЬ@localhost:5432/yol?schema=public"

# Supabase: Project Settings → Database → Connection string.
# Берём ОБЕ строки с хоста *.pooler.supabase.com, а НЕ «Direct connection»
# с db.<ref>.supabase.co — прямое подключение на бесплатном тарифе работает
# только по IPv6, а Vercel и большинство провайдеров ходят по IPv4.
#
# DATABASE_URL — Transaction pooler, порт 6543. По ней работает приложение.
# DIRECT_URL   — Session pooler, порт 5432. Только для миграций: пул в режиме
#                транзакций не переживает DDL.
# DATABASE_URL="postgresql://postgres.ССЫЛКА:ПАРОЛЬ@aws-1-РЕГИОН.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.ССЫЛКА:ПАРОЛЬ@aws-1-РЕГИОН.pooler.supabase.com:5432/postgres"

# --- Сессии ----------------------------------------------------------------
# Ключ подписи cookie. Минимум 32 символа. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# --- Telegram --------------------------------------------------------------
# Токен от @BotFather. Нужен и для входа, и для уведомлений.
TELEGRAM_BOT_TOKEN=""
# Имя бота без @ — его видит браузер, поэтому NEXT_PUBLIC_.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Секрет вебхука: Telegram присылает его заголовком, мы сверяем. Любая
# случайная строка, сгенерировать так же, как SESSION_SECRET.
TELEGRAM_WEBHOOK_SECRET=""
# Домен сайта: подставляется в ссылки внутри уведомлений.
# Он же должен быть прописан боту командой /setdomain у BotFather,
# иначе виджет входа не отрисуется.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Вход через Google и Mail.ru ------------------------------------------
# Кнопка провайдера появляется на странице входа только когда заданы обе
# переменные — иначе пользователь упирался бы в неработающую кнопку.
#
# Google: console.cloud.google.com → APIs & Services → Credentials →
#   Create OAuth client ID → Web application. В Authorized redirect URIs
#   добавить https://ВАШ-ДОМЕН/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
#
# Mail.ru: oauth.mail.ru → создать приложение. Redirect URI —
#   https://ВАШ-ДОМЕН/api/auth/oauth/mailru/callback
#
# Оба провайдера сверяют адрес возврата посимвольно. Лишний слэш на конце,
# http вместо https или другой поддомен дают отказ: у Mail.ru это
# {"error":"invalid request","error_description":"bad redirect_uri"},
# у Google — redirect_uri_mismatch. Изменения в настройках приложения
# применяются не мгновенно — если только что правили, подождите минуту.
MAILRU_CLIENT_ID=""
MAILRU_CLIENT_SECRET=""

# --- Хранилище фото --------------------------------------------------------
# Пока переменные пустые, файлы пишутся на диск в public/uploads — этого
# достаточно локально. На Vercel файловая система только для чтения, поэтому
# в продакшене заполнить обязательно.
# SUPABASE_URL — Project Settings → API → Project URL.
# SUPABASE_SECRET_KEY — там же, API Keys → Secret keys → default (sb_secret_…).
# На старых проектах это ключ service_role — тогда положите его в
# SUPABASE_SERVICE_ROLE_KEY, код принимает оба имени.
# Ключ обходит RLS, живёт только на сервере и НИКОГДА не должен попасть
# в переменную с префиксом NEXT_PUBLIC_.
# Публикуемый ключ (sb_publishable_…) приложению не нужен вообще.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_BUCKET="listing-photos"

# --- Пуши в мобильное приложение -------------------------------------------
# Пока переменные пустые, уведомления идут только в Telegram — ровно как
# раньше. Как только они заданы, приложение получает пуши, а Telegram
# становится запасным каналом для тех, у кого приложения нет.
#
# Что завести: проект в console.firebase.google.com → Project settings →
# Service accounts → Generate new private key. Скачается JSON, из него нужны
# три поля. Аккаунта разработчика Google Play для этого не требуется.
#
# FCM_PROJECT_ID   — поле project_id
# FCM_CLIENT_EMAIL — поле client_email
# FCM_PRIVATE_KEY  — поле private_key целиком, вместе с строками BEGIN/END.
#   Переводы строк внутри ключа записываются как \n — код разворачивает их
#   обратно. В кавычках, одной строкой:
#   FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"
#
# Ключ серверный: он позволяет слать уведомления кому угодно от имени
# приложения. Не переносить в переменную с префиксом NEXT_PUBLIC_.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# --- Разработка ------------------------------------------------------------
# Вход без Telegram на странице /login. Работает только вне продакшена.
# Для проверки чата вдвоём: войти в обычном окне и в приватном под разными именами.
ALLOW_DEV_LOGIN="1"
